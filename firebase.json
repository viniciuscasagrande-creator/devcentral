{
  "hosting": {
    "public": "firebase-public",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "source": "**",
        "run": {
          "serviceId": "devcentral-api",
          "region": "us-central1",
          "pinTag": true
        }
      }
    ]
  }
}
