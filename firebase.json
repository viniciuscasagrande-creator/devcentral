{
  "hosting": {
    "public": "firebase-dist",
    "cleanUrls": true,
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "source": "/telemetria",
        "destination": "/telemetria/index.html"
      },
      {
        "source": "/relatorios",
        "destination": "/relatorios/index.html"
      },
      {
        "source": "/assistente",
        "destination": "/assistente/index.html"
      },
      {
        "source": "/operacoes",
        "destination": "/operacoes/index.html"
      },
      {
        "source": "**",
        "destination": "/index.html"
      }
    ]
  }
}
