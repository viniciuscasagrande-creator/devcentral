# ==============================================================================
# 1. BANCO DE DADOS NEON POSTGRESQL (Persistência na nuvem entre dispositivos)
# ==============================================================================
DATABASE_URL="postgresql://user:password@ep-example.sa-east-1.aws.neon.tech/neondb?sslmode=require"

# ==============================================================================
# 2. CHAVE DE PROTEÇÃO DE SINCRONIZAÇÃO (Opcional)
# ==============================================================================
# Se preenchida, o painel pedirá essa senha ao clicar em "Sincronizar fontes"
DASHBOARD_SYNC_KEY=""
# UID do administrador no Firebase Authentication (devcentral-190fe)
DEVCENTRAL_ADMIN_UID=""

# ==============================================================================
# 3. INTEGRAÇÃO GITHUB (Repositórios públicos e privados)
# ==============================================================================
# Crie um token em: https://github.com/settings/tokens (ou informe apenas GITHUB_USERNAME para públicos)
GITHUB_TOKEN=""
GITHUB_USERNAME=""

# ==============================================================================
# 4. INTEGRAÇÃO GITLAB (Projetos públicos e privados)
# ==============================================================================
# Crie um token em: https://gitlab.com/-/user_settings/personal_access_tokens (escopo: read_api)
GITLAB_TOKEN=""
GITLAB_USERNAME=""
GITLAB_BASE_URL="https://gitlab.com"

# ==============================================================================
# 5. INTEGRAÇÃO VERCEL — DUAS CONTAS INDEPENDENTES (Multi-contas 2.1)
# ==============================================================================
# Crie tokens em: https://vercel.com/account/tokens (um em cada conta Vercel)
VERCEL_ACCOUNT_1_NAME="Minha Vercel Pessoal"
VERCEL_TOKEN_1=""
VERCEL_TEAM_ID_1=""

VERCEL_ACCOUNT_2_NAME="Minha Segunda Vercel"
VERCEL_TOKEN_2=""
VERCEL_TEAM_ID_2=""
